# FD Investment Platform — environment template
# Copy this file to .env.local for local development:  cp .env.example .env.local
# .env.local is git-ignored; NEVER commit real credentials to any env file.

# Base URL for the versioned API. The POC serves /api/v1 through MSW;
# production points this at the real backend host.
NEXT_PUBLIC_API_URL=/api/v1

# Deployment environment: local | development | staging | production
NEXT_PUBLIC_APP_ENV=local

# Enable the MSW mock API layer (true in development until the backend exists).
NEXT_PUBLIC_ENABLE_MOCKS=true
